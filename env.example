# Names only. Put real values in frontend/.env (git-ignored), never here.
OTP_HMAC_SECRET=
DISPATCH_SERVICE_TOKEN=
DISPATCH_SIGNING_SECRET=
# Security switches (SEC-1, SRV-1, SRV-7, SRV-8, SRV-9). Leave unset unless the comment says otherwise.
# ALLOW_REMOTE=1 only on the host that really serves a hosted Supabase project; unset everywhere else (the server then refuses it).
ALLOW_REMOTE=
# How many trusted reverse proxies sit in front of the server (default 1 in production, 0 elsewhere).
TRUSTED_PROXY_HOPS=
# 1 = only signed-in customers may place orders.
ORDERS_REQUIRE_SIGN_IN=
# 1 = allow dev-admin tokens when there is no database (development machines only, never production).
ADMIN_DEV_TOKENS=
# How close to the drop pin, in metres, a proof of delivery must be given (50 to 1000, default 300).
PROOF_MAX_DISTANCE_M=
# Rider KYC on Cashfree Secure ID (docs/RIDER_KYC.md). All three together switch DigiLocker, PAN, selfie and licence checks on; leave them empty and
# riders upload documents that a person checks.
CASHFREE_SECURE_ID_CLIENT_ID=
CASHFREE_SECURE_ID_CLIENT_SECRET=
# 32 random bytes, base64 (openssl rand -base64 32): encrypts the Aadhaar photo kept for the selfie match (24 hours at most).
KYC_PAYLOAD_KEY=
# Optional: sandbox | production (the secret's prefix decides by itself), Cashfree's 2FA public key (PEM) when this server's IP is not whitelisted,
# the Cashfree API version, checks per rider per day (5), face match threshold (0.75), where DigiLocker sends the rider in the app, and the public
# https address of this API (else PUBLIC_BASE_URL) that DigiLocker returns to.
CASHFREE_SECURE_ID_ENV=
CASHFREE_SECURE_ID_PUBLIC_KEY=
CASHFREE_SECURE_ID_API_VERSION=
KYC_ATTEMPTS_PER_DAY=
KYC_FACE_MATCH_THRESHOLD=
KYC_APP_RETURN_URL=
KYC_PUBLIC_BASE_URL=
