{
  "expo": {
    "name": "OneLocal",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "onecity",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Find products using a photo",
        "NSMicrophoneUsageDescription": "Search for products with your voice",
        "NSPhotoLibraryUsageDescription": "Choose product photos for visual search",
        "NSLocationWhenInUseUsageDescription": "OneLocal uses your location to find your delivery address.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.proviyaa.onelatur"
    },
    "android": {
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundImage": "./assets/images/adaptive-icon-background.png",
        "monochromeImage": "./assets/images/adaptive-icon-monochrome.png",
        "backgroundColor": "#76EC00"
      },
      "package": "com.proviyaa.onelatur",
      "versionCode": 12
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140,
          "resizeMode": "contain",
          "backgroundColor": "#0B1A10"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "@react-native-vector-icons/ionicons",
      "expo-video",
      [
        "expo-audio",
        {
          "microphonePermission": "Search for products with your voice"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Find products using a photo",
          "photosPermission": "Choose product photos for visual search",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "OneLocal uses your location to find your delivery address."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
